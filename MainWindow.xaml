<Window x:Class="GerenciadorProdutos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro de Produtos" Height="640" Width="980"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6" FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Painel esquerdo: campos e botões do menu -->
        <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Cadastro de Produtos" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,14"/>

                    <TextBlock Text="Id (buscar, atualizar ou excluir)" Foreground="#374151"/>
                    <TextBox x:Name="txtId" Margin="0,4,0,10" Padding="5" FontSize="14"/>

                    <TextBlock Text="Nome" Foreground="#374151"/>
                    <TextBox x:Name="txtNome" Margin="0,4,0,10" Padding="5" FontSize="14"/>

                    <TextBlock Text="Preço (ex: 19,90)" Foreground="#374151"/>
                    <TextBox x:Name="txtPreco" Margin="0,4,0,10" Padding="5" FontSize="14"/>

                    <TextBlock Text="Estoque" Foreground="#374151"/>
                    <TextBox x:Name="txtEstoque" Margin="0,4,0,10" Padding="5" FontSize="14"/>

                    <TextBlock Text="Categoria" Foreground="#374151"/>
                    <TextBox x:Name="txtCategoria" Margin="0,4,0,16" Padding="5" FontSize="14"/>

                    <Button Content="1. Inserir produto"     Style="{StaticResource BotaoSucesso}" Click="BtnInserir_Click"/>
                    <Button Content="2. Listar produtos"     Style="{StaticResource BotaoAcao}"    Click="BtnListar_Click"/>
                    <Button Content="3. Buscar produto por ID" Style="{StaticResource BotaoAcao}"  Click="BtnBuscar_Click"/>
                    <Button Content="4. Atualizar produto"   Style="{StaticResource BotaoAcao}"    Click="BtnAtualizar_Click"/>
                    <Button Content="5. Excluir produto"     Style="{StaticResource BotaoPerigo}"  Click="BtnExcluir_Click"/>
                    <Button Content="6. Sair"                Style="{StaticResource BotaoNeutro}"  Click="BtnSair_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Painel direito: lista de produtos -->
        <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Produtos cadastrados" FontSize="16" FontWeight="SemiBold"
                           Foreground="#111827" Margin="0,0,0,10"/>
                <DataGrid x:Name="dgProdutos"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E7EB" BorderThickness="0"
                          RowHeight="30" Background="White"
                          SelectionChanged="DgProdutos_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id"        Binding="{Binding Id}"        Width="60"/>
                        <DataGridTextColumn Header="Nome"      Binding="{Binding Nome}"      Width="*"/>
                        <DataGridTextColumn Header="Preço"     Binding="{Binding Preco, StringFormat=C, ConverterCulture=pt-BR}" Width="110"/>
                        <DataGridTextColumn Header="Estoque"   Binding="{Binding Estoque}"   Width="80"/>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Barra de status -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" CornerRadius="8" Padding="12,8" Margin="0,16,0,0">
            <TextBlock x:Name="txtStatus" Text="Pronto." FontSize="13" Foreground="#374151"/>
        </Border>
    </Grid>
</Window>
