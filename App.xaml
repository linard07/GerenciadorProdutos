<Application x:Class="GerenciadorProdutos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <Style x:Key="BotaoAcao" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borda" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borda" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borda" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoAcao}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <Style x:Key="BotaoNeutro" TargetType="Button" BasedOn="{StaticResource BotaoAcao}">
            <Setter Property="Background" Value="#6B7280"/>
        </Style>

        <Style x:Key="BotaoSucesso" TargetType="Button" BasedOn="{StaticResource BotaoAcao}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

    </Application.Resources>
</Application>
